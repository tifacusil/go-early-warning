# Plantilla de configuracion. Copiar a .env (gitignored) y rellenar.
# Toda config externalizada (CLAUDE.md §1.7). Ningun valor hardcodeado en codigo.

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# MySQL (database-per-service: un esquema por servicio)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASS=root

# Consul
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
CONSUL_SCHEME=http
CONSUL_TOKEN=

# early-warning service
EARLY_WARNING_PORT=8083
