# Variables leidas por el servicio early-warning. Claves alineadas al contrato
# de tesis-infra (local/services/envs/early-warning.env). Config externalizada
# (CLAUDE.md §1.7). En infra el env_file lo provee el repo de infraestructura.

# HTTP
HTTP_PORT=8080
INSTANCE_ID=early-warning-1

# RabbitMQ
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USER=early_warning
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=early_warning.evaluate
# Exchange destino de alertas (pre-declarado en infra: sensors.raw)
ALERTS_EXCHANGE=sensors.raw

# Redis (compartido en infra, host "redis")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MySQL — BD exclusiva del servicio (database-per-service §1.2)
MYSQL_HOST=mysql-early-warning
MYSQL_PORT=3306
MYSQL_DATABASE=early_warning
MYSQL_USER=svc_early_warning
MYSQL_PASSWORD=

# data-analysis — gRPC con circuit breaker (CLAUDE.md §2.3)
DATA_ANALYSIS_GRPC=data-analysis-1:50051
DATA_ANALYSIS_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# user-management — gRPC, resolucion de tokens FCM
USER_MANAGEMENT_GRPC=user-management-1:9090
USER_MANAGEMENT_TIMEOUT_MS=5000

# Firebase / FCM (opcional; sin credenciales -> push no-op)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Consul
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_SCHEME=http
CONSUL_TOKEN=

# App
MAX_DT_SECONDS=7200
REPORT_SCHEDULER_ENABLED=true
LOG_LEVEL=info
ENV=dev
